# Keep the build context small and platform-clean.
# .venv is macOS-built: shipping it into a linux/amd64 image breaks pymupdf.
.venv/
.git/
.github/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
cdk.out/
infra/
tests/
.env
.DS_Store
Claude outputs/
*.png
*.jpg

# data/ is NOT excluded: the image copies it so a hosted demo can serve a
# corpus. With no corpus present the directory holds only a README and the
# app falls back to the seeded walkthrough, which /ready reports.
